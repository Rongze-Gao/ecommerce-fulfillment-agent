# 复制为本目录下的 .env 后再填写真实密码。不要提交 .env。
# 主机端口是本机映射端口，需与 docker compose 中的容器端口对应。

# MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_HOST_PORT=23306

# MySQL initialization
MYSQL_DATABASE=ecommerce_fulfillment
MYSQL_USER=ecommerce_app
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_PASSWORD=your_mysql_app_password

# Redis connection
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=26380
REDIS_PASSWORD=your_redis_password
# DB 0：RAG向量与评论切块
REDIS_DATABASE=0
# DB 1：Agent对话历史
REDIS_CHAT_DATABASE=1

# Ollama connection
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ollama models
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_TRANSLATION_MODEL=qwen3:14b
OLLAMA_CHAT_MODEL=qwen3:14b

# MCP server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=28080